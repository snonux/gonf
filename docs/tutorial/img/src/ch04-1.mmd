flowchart TB
    subgraph app.conf
        A["# app.conf  (untouched)"]
        B["port=8080  (WithKeyedLine: owns the line starting with port=)"]
        C["user=paul  (untouched)"]
        D["# BEGIN GONF peers ... # END GONF peers  (WithBlock: owns the region)"]
